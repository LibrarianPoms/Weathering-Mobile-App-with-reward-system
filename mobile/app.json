{
    "expo": {
        "name": "Weathering Waves",
        "slug": "weathering-waves",
        "version": "1.0.0",
        "orientation": "portrait",
        "userInterfaceStyle": "dark",
        "assetBundlePatterns": [
            "**/*"
        ],
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.weatheringwaves.app"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#1a1a2e"
            },
            "package": "com.weatheringwaves.app",
            "permissions": [
                "ACCESS_FINE_LOCATION",
                "ACCESS_COARSE_LOCATION"
            ]
        },
        "plugins": [
            [
                "expo-location",
                {
                    "locationAlwaysAndWhenInUsePermission": "Allow Weathering Waves to use your location to show local weather."
                }
            ]
        ]
    }
}